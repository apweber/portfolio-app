generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum WorkPreference {
  REMOTE
  HYBRID
  ONSITE
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  APPLIED
  PHONE_SCREEN
  INTERVIEWING
  OFFER
  REJECTED
}

model Profile {
  id                String          @id
  email             String          @unique
  name              String
  role              Role            @default(USER)
  targetSalary      Int?
  workPreference    WorkPreference?
  preferredLocation String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  skills            Skill[]
  fitWeights        FitWeights?
  jobs              Job[]
  companiesCreated  Company[]
}

model Skill {
  id          String      @id @default(cuid())
  userId      String
  user        Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  proficiency Proficiency @default(INTERMEDIATE)
  createdAt   DateTime    @default(now())

  @@unique([userId, name])
}

model FitWeights {
  userId         String  @id
  user           Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillsWeight   Int     @default(40)
  salaryWeight   Int     @default(30)
  remoteWeight   Int     @default(20)
  locationWeight Int     @default(10)
}

model Company {
  id           String   @id @default(cuid())
  name         String
  industry     String?
  size         String?
  location     String?
  website      String?
  cultureNotes String?
  createdById  String
  createdBy    Profile  @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
}

model Job {
  id              String            @id @default(cuid())
  userId          String
  companyId       String
  title           String
  description     String?
  postingUrl      String?
  salaryRangeMin  Int?
  salaryRangeMax  Int?
  workPreference  WorkPreference?
  location        String?
  status          ApplicationStatus @default(APPLIED)
  applicationDate DateTime?
  notes           String?
  fitScore        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id])
  requiredSkills  JobSkill[]
  tags            JobTag[]
}

model JobSkill {
  id        String @id @default(cuid())
  jobId     String
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillName String

  @@unique([jobId, skillName])
}

model JobTag {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   String

  @@unique([jobId, tag])
}
